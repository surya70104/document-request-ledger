# Copy to .env (setup_and_run.ps1 does this for you and asks for the password).
# If your password contains special characters, URL-encode them (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/oak_request_ledger

# Local bind address for the web app (dedicated port for this module).
APP_HOST=127.0.0.1
APP_PORT=8015

# Firm name printed on the exported audit thread.
FIRM_NAME=OAK Audit

# Outbound email. Leave SMTP_HOST empty to run in "local outbox" mode: every email is stored and
# shown on the Outbox page (links inside it work on localhost) but nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Address clients can reach this app on (used in the links inside emails). Default: http://APP_HOST:APP_PORT
PUBLIC_BASE_URL=

# WhatsApp. Leave WHATSAPP_PROVIDER empty to run the built-in WhatsApp Simulator (nothing is sent;
# open /whatsapp to see messages and play the client). provider = meta (WhatsApp Business Cloud API)
# or generic (any gateway taking POST {"to","body"} with a Bearer token at WHATSAPP_API_URL).
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Seconds of quiet after which a client's photos are assembled into one submission.
WHATSAPP_ASSEMBLY_SECONDS=120

# Retention (DPDP Rules 2025 vs SA 230): days a REJECTED file lingers before it is erased, and the long
# safety window for a file still awaiting a decision. Evidence is held 7 years; the job runs daily.
NONE_RETENTION_DAYS=30
PENDING_RETENTION_DAYS=180
RETENTION_JOB_INTERVAL=86400
